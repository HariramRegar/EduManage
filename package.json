{
  "name": "edumanage",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "electronMain": "electron/main.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "desktop:dev": "cross-env NODE_ENV=development PORT=3000 concurrently \"expo start --web --port 3000 --non-interactive\" \"wait-on http://localhost:3000 && electron electron/main.js\"",
    "desktop:build": "npm run export:web && electron-builder --mac",
    "export:web": "expo export --platform web && mkdir -p dist && cp -R dist/web-build/* dist/"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.18.2",
    "@react-navigation/native": "^6.1.7",
    "@react-navigation/native-stack": "^6.9.13",
    "dotenv": "^17.2.2",
    "expo": "~49.0.0",
    "expo-file-system": "~15.4.5",
    "expo-font": "~11.4.0",
    "expo-print": "~12.4.0",
    "expo-splash-screen": "~0.20.5",
    "expo-status-bar": "~1.6.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.72.10",
    "react-native-date-picker": "^4.3.3",
    "react-native-paper": "^5.10.6",
    "react-native-pdf": "^6.7.3",
    "react-native-safe-area-context": "4.6.3",
    "react-native-screens": "~3.22.0",
    "react-native-vector-icons": "^10.0.0",
    "react-native-web": "~0.19.6",
    "expo-image-picker": "~14.3.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~18.2.14",
    "@types/react-native": "~0.72.2",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.1.3",
    "wait-on": "^7.2.0"
  },
  "private": true
}
